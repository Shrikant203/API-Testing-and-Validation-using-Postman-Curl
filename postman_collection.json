{
  "info": {
    "name": "Digit Classification API - Task 5 Testing",
    "description": "Postman collection for testing and validating the Task 4 Flask REST API (Digit Classification API). Covers positive (functional) tests and negative (error-handling) tests for every endpoint.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:5000" }
  ],
  "item": [
    {
      "name": "1. Positive Tests",
      "item": [
        {
          "name": "GET / - API Info",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response has name and endpoints fields', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('name');",
                  "    pm.expect(json).to.have.property('endpoints');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /health - Health Check",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('model_loaded is true', function () {",
                  "    pm.expect(pm.response.json().model_loaded).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /predict - Valid Image (digit 0)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/predict",
            "body": {
              "mode": "raw",
              "raw": "{\"image\": [0,0,5,13,9,1,0,0, 0,0,13,15,10,15,5,0, 0,3,15,2,0,11,8,0, 0,4,12,0,0,8,8,0, 0,5,8,0,0,9,8,0, 0,4,11,0,1,12,7,0, 0,2,14,5,10,12,0,0, 0,0,6,13,10,0,0,0]}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response has predicted_digit, confidence, probabilities', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('predicted_digit');",
                  "    pm.expect(json).to.have.property('confidence');",
                  "    pm.expect(json).to.have.property('probabilities');",
                  "});",
                  "pm.test('predicted_digit is 0 as expected', function () {",
                  "    pm.expect(pm.response.json().predicted_digit).to.eql(0);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /predict/batch - Valid Batch (3 real digits)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/predict/batch",
            "body": {
              "mode": "raw",
              "raw": "{\"images\": [[0,0,5,13,9,1,0,0,0,0,13,15,10,15,5,0,0,3,15,2,0,11,8,0,0,4,12,0,0,8,8,0,0,5,8,0,0,9,8,0,0,4,11,0,1,12,7,0,0,2,14,5,10,12,0,0,0,0,6,13,10,0,0,0]]}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response has count and results', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('count');",
                  "    pm.expect(json).to.have.property('results');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Negative Tests (Error Handling)",
      "item": [
        {
          "name": "POST /predict - Missing 'image' field",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/predict",
            "body": { "mode": "raw", "raw": "{}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400', function () { pm.response.to.have.status(400); });",
                  "pm.test('Response has error field', function () {",
                  "    pm.expect(pm.response.json()).to.have.property('error');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /predict - Wrong-size image array",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/predict",
            "body": { "mode": "raw", "raw": "{\"image\": [1, 2, 3]}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400', function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /predict - Invalid JSON body",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/predict",
            "body": { "mode": "raw", "raw": "not-json" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400', function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /predict/batch - Empty images list",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/predict/batch",
            "body": { "mode": "raw", "raw": "{\"images\": []}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400', function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /nonexistent - Unknown endpoint",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/nonexistent"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 404', function () { pm.response.to.have.status(404); });"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /predict - Wrong HTTP method",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/predict"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 405', function () { pm.response.to.have.status(405); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
